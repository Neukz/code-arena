# PostgreSQL
DATABASE_URL=postgres://codearena:codearena@localhost:5432/codearena?sslmode=disable

# RabbitMQ
RABBITMQ_URL=amqp://codearena:codearena@localhost:5672/

# API gateway (used by the Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8080

# CORS allowed origins for the API gateway (comma-separated; default is "*" for local dev)
CORS_ALLOWED_ORIGINS=*

# Docker
DOCKER_HOST=unix:///var/run/docker.sock

# Paths used by integration tests and migration tasks
GOOSE_MIGRATION_DIR=./sql/schema
SEED_PROBLEMS_PATH=./scripts/seed_problems.sql
